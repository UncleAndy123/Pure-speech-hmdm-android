<?xml version="1.0" encoding="utf-8"?>
<!--
    Unified dialer + call history screen.

    Tab bar at top: CONTACTS | ALL | MISSED | IN | OUT
    Below: either the contacts section or history section, mutually exclusive.

    Contacts section: search field + contact list (unchanged)
    History section:  call log list + empty label
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:theme="@style/Theme.AppCompat.Light.NoActionBar"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="HardcodedText,SmallSp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F7">

    <!-- ============================================================ -->
    <!-- HEADER CARD — title + tab bar                                -->
    <!-- ============================================================ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="8dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:letterSpacing="0.1"
            android:text="PHONE"
            android:textColor="#757575"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- Tab row -->
        <LinearLayout
            style="?android:attr/buttonBarStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/tab_all"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:layout_marginEnd="2dp"
                android:text="ALL"
                android:textSize="9sp"
                android:textStyle="bold"
                android:background="@drawable/modern_button_selector"
                android:textColor="#FFFFFF"
                android:focusable="true"
                android:focusableInTouchMode="true"

                 android:stateListAnimator="@null" />

            <Button
                android:id="@+id/tab_contacts"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:layout_marginEnd="2dp"
                android:text="CONTACTS"
                android:textSize="9sp"
                android:textStyle="bold"
                android:background="@drawable/modern_button_selector"
                android:textColor="#FFFFFF"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:stateListAnimator="@null" />


            <Button
                android:id="@+id/tab_missed"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:layout_marginEnd="2dp"
                android:text="MISSED"
                android:textSize="9sp"
                android:textStyle="bold"
                android:background="@drawable/modern_button_selector"
                android:textColor="#FFFFFF"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/tab_incoming"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:background="@drawable/modern_button_selector"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:stateListAnimator="@null"
                android:text="IN"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold"
                tools:ignore="TouchTargetSizeCheck" />

            <Button
                android:id="@+id/tab_outgoing"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:text="OUT"
                android:textSize="9sp"
                android:textStyle="bold"
                android:background="@drawable/modern_button_selector"
                android:textColor="#FFFFFF"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:stateListAnimator="@null" />

        </LinearLayout>

    </LinearLayout>

    <!-- ============================================================ -->
    <!-- CONTACTS SECTION                                              -->
    <!-- Visible when CONTACTS tab is active                          -->
    <!-- ============================================================ -->
    <LinearLayout
        android:id="@+id/dialer_contacts_section"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="visible">

        <!-- Search / dial input row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#FFFFFF"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/dialer_search"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="4"
                android:background="#F2F2F7"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:hint="Press any key to Dial"
                android:imeOptions="actionDone"
                android:inputType="phone"
                android:digits="0123456789+*#- ()"
                android:nextFocusRight="@+id/dialer_dial_button"
                android:nextFocusDown="@+id/dialer_contact_list"
                android:paddingStart="8dp"
                android:singleLine="true"
                android:textColor="#1C1C1E"
                android:textColorHint="#1B1B1D"
                android:textSize="14sp" />

            <Button
                android:id="@+id/dialer_dial_button"
                android:layout_width="60dp"
                android:layout_height="36dp"
                android:text="CALL"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#34C759"
                android:focusable="true"
                android:visibility="gone"
                android:nextFocusLeft="@+id/dialer_search" />

        </LinearLayout>

        <!-- Contact list -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/dialer_contact_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:nextFocusUp="@+id/dialer_search" />

    </LinearLayout>

    <!-- ============================================================ -->
    <!-- HISTORY SECTION                                               -->
    <!-- Visible when ALL / MISSED / IN / OUT tab is active           -->
    <!-- ============================================================ -->
    <FrameLayout
        android:id="@+id/dialer_history_section"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/dialer_history_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/dialer_history_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="No call history"
            android:textColor="#8E8E93"
            android:textSize="14sp"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>