<?xml version="1.0" encoding="utf-8"?>
<!--
    Single row in the app visibility list inside HomeCustomizationActivity.
    Shows app label, package name, and a toggle switch.
    Focusable for d-pad navigation.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingLeft="4dp"
    android:paddingRight="4dp"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:background="?android:attr/selectableItemBackground">

    <!-- App name + package -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginRight="8dp">

        <TextView
            android:id="@+id/customize_app_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/customize_app_pkg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#666666"
            android:textSize="10sp"
            android:ellipsize="end"
            android:maxLines="1" />

    </LinearLayout>

    <!-- Visible toggle -->
    <Switch
        android:id="@+id/customize_app_toggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:focusable="false"
        android:clickable="false"
        android:thumbTint="#FFFFFF"
        android:trackTint="#1B5E20" />

</LinearLayout>