<?xml version="1.0" encoding="utf-8"?>
<!--
    In-call screen — with collapsible DTMF dialpad.
    Controls row: MUTE | KEYPAD | SPEAKER
    Dialpad grid: hidden by default, shown when KEYPAD toggled.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:theme="@style/Theme.AppCompat.Light.NoActionBar"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="HardcodedText,SmallSp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="#F5F5F7"
    android:padding="16dp">

    <!-- Status: Calling... / Connected -->
    <TextView
        android:id="@+id/incall_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Calling..."
        android:textColor="#007AFF"
        android:textStyle="bold"
        android:textSize="12sp"
        android:layout_marginTop="10dp" />

    <!-- Call timer -->
    <TextView
        android:id="@+id/incall_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#1C1C1E"
        android:textSize="32sp"
        android:layout_marginTop="8dp"
        android:visibility="invisible" />

    <!-- Caller name -->
    <TextView
        android:id="@+id/incall_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="22sp"
        android:textColor="#1C1C1E"
        android:textStyle="bold"
        android:gravity="center"
        android:singleLine="true"
        android:ellipsize="end"
        android:layout_marginTop="4dp" />

    <!-- Caller number -->
    <TextView
        android:id="@+id/incall_number"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="#8E8E93"
        android:gravity="center" />

    <!-- ============================================================ -->
    <!-- DTMF DIALPAD — hidden by default, shown when KEYPAD pressed  -->
    <!-- ============================================================ -->
    <LinearLayout
        android:id="@+id/incall_dialpad_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginTop="12dp">

        <!-- Typed digits display -->
        <TextView
            android:id="@+id/incall_dialed_digits"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="18sp"
            android:textColor="#1C1C1E"
            android:gravity="center"
            android:minHeight="28dp"
            android:layout_marginBottom="8dp"
            android:letterSpacing="0.2" />

        <!-- Row 1: 1 2 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">
            <Button android:id="@+id/dtmf_1" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginRight="4dp" android:text="1" android:textSize="16sp" android:textStyle="bold" android:backgroundTint="#FFFFFF" android:textColor="#1C1C1E" android:stateListAnimator="@null" android:focusable="true" android:focusableInTouchMode="true" />
            <Button android:id="@+id/dtmf_2" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginRight="4dp" android:text="2" android:textSize="16sp" android:textStyle="bold" android:backgroundTint="#FFFFFF" android:textColor="#1C1C1E" android:stateListAnimator="@null" android:focusable="true" android:focusableInTouchMode="true" />
            <Button android:id="@+id/dtmf_3" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="3" android:textSize="16sp" android:textStyle="bold" android:backgroundTint="#FFFFFF" android:textColor="#1C1C1E" android:stateListAnimator="@null" android:focusable="true" android:focusableInTouchMode="true" />
        </LinearLayout>

        <!-- Row 2: 4 5 6 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">
            <Button android:id="@+id/dtmf_4" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginRight="4dp" android:text="4" android:textSize="16sp" android:textStyle="bold" android:backgroundTint="#FFFFFF" android:textColor="#1C1C1E" android:stateListAnimator="@null" android:focusable="true" android:focusableInTouchMode="true" />
            <Button android:id="@+id/dtmf_5" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginRight="4dp" android:text="5" android:textSize="16sp" android:textStyle="bold" android:backgroundTint="#FFFFFF" android:textColor="#1C1C1E" android:stateListAnimator="@null" android:focusable="true" android:focusableInTouchMode="true" />
            <Button android:id="@+id/dtmf_6" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="6" android:textSize="16sp" android:textStyle="bold" android:backgroundTint="#FFFFFF" android:textColor="#1C1C1E" android:stateListAnimator="@null" android:focusable="true" android:focusableInTouchMode="true" />
        </LinearLayout>

        <!-- Row 3: 7 8 9 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">
            <Button android:id="@+id/dtmf_7" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginRight="4dp" android:text="7" android:textSize="16sp" android:textStyle="bold" android:backgroundTint="#FFFFFF" android:textColor="#1C1C1E" android:stateListAnimator="@null" android:focusable="true" android:focusableInTouchMode="true" />
            <Button android:id="@+id/dtmf_8" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginRight="4dp" android:text="8" android:textSize="16sp" android:textStyle="bold" android:backgroundTint="#FFFFFF" android:textColor="#1C1C1E" android:stateListAnimator="@null" android:focusable="true" android:focusableInTouchMode="true" />
            <Button android:id="@+id/dtmf_9" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="9" android:textSize="16sp" android:textStyle="bold" android:backgroundTint="#FFFFFF" android:textColor="#1C1C1E" android:stateListAnimator="@null" android:focusable="true" android:focusableInTouchMode="true" />
        </LinearLayout>

        <!-- Row 4: * 0 # -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">
            <Button android:id="@+id/dtmf_star" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginRight="4dp" android:text="*" android:textSize="20sp" android:backgroundTint="#FFFFFF" android:textColor="#1C1C1E" android:stateListAnimator="@null" android:focusable="true" android:focusableInTouchMode="true" />
            <Button android:id="@+id/dtmf_0" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginRight="4dp" android:text="0" android:textSize="16sp" android:textStyle="bold" android:backgroundTint="#FFFFFF" android:textColor="#1C1C1E" android:stateListAnimator="@null" android:focusable="true" android:focusableInTouchMode="true" />
            <Button android:id="@+id/dtmf_hash" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="#" android:textSize="16sp" android:textStyle="bold" android:backgroundTint="#FFFFFF" android:textColor="#1C1C1E" android:stateListAnimator="@null" android:focusable="true" android:focusableInTouchMode="true" />
        </LinearLayout>

    </LinearLayout>

    <!-- Spacer — pushes controls to bottom -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- ============================================================ -->
    <!-- CONTROLS ROW: MUTE | KEYPAD | SPEAKER                        -->
    <!-- ============================================================ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/incall_mute"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginRight="4dp"
            android:text="MUTE"
            android:textSize="11sp"
            android:textColor="@color/history_text_selector"
            android:background="@drawable/modern_button_selector"
            android:focusable="true"
            android:nextFocusRight="@+id/incall_keypad"
            android:nextFocusDown="@+id/incall_hangup" />

        <Button
            android:id="@+id/incall_keypad"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginRight="4dp"
            android:text="KEYPAD"
            android:textSize="11sp"
            android:textColor="@color/history_text_selector"
            android:background="@drawable/modern_button_selector"
            android:focusable="true"
            android:nextFocusLeft="@+id/incall_mute"
            android:nextFocusRight="@+id/incall_speaker"
            android:nextFocusDown="@+id/incall_hangup" />

        <Button
            android:id="@+id/incall_speaker"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="SPEAKER"
            android:textSize="11sp"
            android:textColor="@color/history_text_selector"
            android:background="@drawable/modern_button_selector"
            android:focusable="true"
            android:nextFocusLeft="@+id/incall_keypad"
            android:nextFocusDown="@+id/incall_hangup" />

    </LinearLayout>

    <!-- Hang up -->
    <Button
        android:id="@+id/incall_hangup"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="HANG UP"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#FF3B30"
        android:focusable="true"
        android:nextFocusUp="@+id/incall_mute" />

</LinearLayout>